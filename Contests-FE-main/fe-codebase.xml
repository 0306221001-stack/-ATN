              target={linkType === 'web' ? '_blank' : undefined}
              rel={linkType === 'web' ? 'noopener' : undefined}
            >
              {value}
            </Link>
          ) : (
            value
          )}
        </Typography>
      </Box>
    </Box>
  );
};

