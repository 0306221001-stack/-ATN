    const bannerInterval = setInterval(() => {
      setCurrentBanner(prev => (prev + 1) % banners.length);
    }, 5000);
    return () => clearInterval(bannerInterval);
  }, []);

  const nextBanner = () => setCurrentBanner(prev => (prev + 1) % banners.length);
