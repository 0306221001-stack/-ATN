            };
            return updated;
          });

          // Cập nhật groupName/groupId cho thí sinh trong danh sách tổng
          setcontestant(prev =>
            prev.map(c =>
              newContestants.some(nc => nc.id === c.id)
                ? {
                    ...c,
                    groupName:
                      existingGroups?.[activeGroupTab]?.name ||
                      `Nhóm ${activeGroupTab + 1}`,
                    groupId: existingGroups?.[activeGroupTab]?.id,
