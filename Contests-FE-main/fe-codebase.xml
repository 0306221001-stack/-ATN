}) => {
  const [formData, setFormData] = useState<UserFormData>({
    username: "",
    password: "",
    email: "",
    role: "Judge",
    isActive: true,
  });
  const [isVisible, setIsVisible] = useState(false);

  useEffect(() => {
    if (isOpen) {
      setIsVisible(true);
    } else {
      const timer = setTimeout(() => setIsVisible(false), 200);
      return () => clearTimeout(timer);
    }
    return () => {};
  }, [isOpen]);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onAdd(formData);
    setFormData({
      username: "",
      password: "",
      email: "",
      role: "Judge",
      isActive: true,
