                >
                  {errors.videos.message as string}
                </Typography>
              )}
            </Box>
          </Box>          <Box sx={{ display: "flex", gap: 2, mt: 2 }}>
            <Button variant="outlined" onClick={onClose} fullWidth disabled={isLoading}>
              Hủy
