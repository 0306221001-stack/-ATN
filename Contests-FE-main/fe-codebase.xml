      showToast(`Tạo nhóm "${newGroupName}" thành công`, "success");
    } catch (error) {
      console.error("Error creating new group:", error);
      let errorMessage = "Lỗi khi tạo nhóm mới";
      if (error && typeof error === "object" && "response" in error) {
        const response = (
