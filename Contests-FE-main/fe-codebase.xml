      GroupDivisionService.updateGroupName(group.id, newName)
        .then(() => {
          // Cập nhật local state
          setGroups(prev => ({
            ...prev,
            [groupIndex]: prev[groupIndex].map(c => ({
              ...c,
              groupName: newName,
            })),
          }));
          // Cập nhật groupName cho thí sinh trong danh sách tổng
