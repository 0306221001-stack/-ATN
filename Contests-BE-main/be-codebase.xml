  static async delete(req: Request, res: Response): Promise<void> {
    try {
      const id = req.params.id;
      const Rescue = await RescueService.getRescueBy({ id: Number(id) });
      if (!Rescue) {
        throw new Error("Không tìm thấy cứu trợ ");
