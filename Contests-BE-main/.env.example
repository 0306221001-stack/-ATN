# ===============================
# Cấu hình môi trường cho Backend
# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG nộp/gửi file .env.
# ===============================

NODE_ENV=development
PORT=3000

# Kết nối MySQL/MariaDB. XAMPP mặc định: user root, không có mật khẩu.
# Dạng: mysql://USER:MATKHAU@HOST:CONG/TEN_DATABASE
DATABASE_URL="mysql://root:@localhost:3306/contests_db"

# Khóa ký token đăng nhập: đặt một chuỗi ngẫu nhiên dài (>= 32 ký tự).
JWT_SECRET=doi-thanh-mot-chuoi-ngau-nhien-rat-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Các địa chỉ web được phép gọi API (cách nhau bằng dấu phẩy, không có khoảng trắng).
# 5173 = web admin, 5000 = app Flutter chạy trên Chrome.
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

API_URL=http://localhost:3000
LOG_LEVEL=info

# Tài khoản Admin tạo khi chạy "npm run prisma:seed" (không cần nếu đã nhập sẵn database).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# SMTP để gửi mã OTP quên mật khẩu. Có thể bỏ trống nếu không thử chức năng này.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
