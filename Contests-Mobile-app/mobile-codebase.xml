import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';

import '../../features/auth/data/auth_repository.dart';
import '../../features/auth/domain/auth_user.dart';
import '../../features/auth/presentation/login_screen.dart';
import '../../features/auth/presentation/splash_screen.dart';
import 'app_routes.dart';
import 'auth_guard.dart';

/// Provider `GoRouter` của toàn app.
///
/// Auth Guard hoạt động qua `redirect` + `refreshListenable`: mỗi khi trạng
/// thái phiên đổi (đăng nhập, đăng xuất, phiên hết hạn, đăng nhập nơi khác),
/// router tự đánh giá lại và đưa người dùng đến đúng màn hình.
final Provider<GoRouter> appRouterProvider = Provider<GoRouter>((ref) {
  final AuthSessionController session =
      ref.watch(authSessionControllerProvider);

  final GoRouter router = GoRouter(
    initialLocation: AppRoutes.splash,
    debugLogDiagnostics: kDebugMode,
    refreshListenable: session,
    redirect: (BuildContext context, GoRouterState state) {
      return resolveAuthRedirect(
        status: session.status,
        user: session.user,
        location: state.uri.toString(),
      );
    },
    errorBuilder: (BuildContext context, GoRouterState state) {
      return const _NotFoundScreen();
    },
    routes: <RouteBase>[
      GoRoute(
        path: '/',
        redirect: (BuildContext context, GoRouterState state) =>
            AppRoutes.splash,
      ),
      GoRoute(
        path: AppRoutes.splash,
        builder: (BuildContext context, GoRouterState state) =>
            const SplashScreen(),
      ),

      // --- Công khai -------------------------------------------------------
      GoRoute(
        path: AppRoutes.login,
        builder: (BuildContext context, GoRouterState state) {
          final bool isJudge = state.uri.queryParameters['role'] == 'judge';
          return LoginScreen(
            initialRole: isJudge ? UserRole.judge : UserRole.student,
          );
        },
      ),
      GoRoute(
        path: AppRoutes.register,
        builder: (BuildContext context, GoRouterState state) {
          return const _PlaceholderScreen(
            title: 'Đăng ký thí sinh',
            description: 'Màn hình đăng ký sẽ được hoàn thiện ở bước tiếp theo.',
            requiresAuth: false,
          );
        },
      ),
      GoRoute(
        path: AppRoutes.forgotPassword,
        builder: (BuildContext context, GoRouterState state) {
          return const _PlaceholderScreen(
            title: 'Quên mật khẩu',
            description:
                'Màn hình lấy lại mật khẩu bằng OTP sẽ được hoàn thiện ở bước tiếp theo.',
            requiresAuth: false,
          );
        },
      ),

      // --- Thí sinh --------------------------------------------------------
      GoRoute(
        path: AppRoutes.studentDashboard,
        builder: (BuildContext context, GoRouterState state) {
          return const _PlaceholderScreen(
            title: 'Trang thí sinh',
            description: 'Danh sách trận đấu của thí sinh (Step 3).',
          );
        },
      ),
      GoRoute(
        path: AppRoutes.studentMatch,
        builder: (BuildContext context, GoRouterState state) {
          return _PlaceholderScreen(
            title: 'Phòng chờ trận đấu',
            description:
                'Trận: ${state.pathParameters['matchSlug'] ?? ''} (Step 3).',
          );
        },
      ),

      // --- Trọng tài -------------------------------------------------------
      GoRoute(
        path: AppRoutes.judgeContests,
        builder: (BuildContext context, GoRouterState state) {
          return const _PlaceholderScreen(
            title: 'Danh sách cuộc thi',
            description: 'Trọng tài chọn cuộc thi (Step 3).',
          );
        },
      ),
      GoRoute(
        path: AppRoutes.judgeMatches,
        builder: (BuildContext context, GoRouterState state) {
          return _PlaceholderScreen(
            title: 'Danh sách trận đấu',
            description:
                'Cuộc thi #${state.pathParameters['contestId'] ?? ''} (Step 3).',
          );
        },
      ),
      GoRoute(
        path: AppRoutes.judgeMatchControl,
        builder: (BuildContext context, GoRouterState state) {
          return _PlaceholderScreen(
            title: 'Điều khiển trận đấu',
            description:
                'Trận: ${state.pathParameters['match'] ?? ''} (Step 3).',
          );
        },
      ),

      // --- Dùng chung ------------------------------------------------------
      GoRoute(
        path: AppRoutes.profile,
        builder: (BuildContext context, GoRouterState state) {
          return const _PlaceholderScreen(
            title: 'Hồ sơ cá nhân',
            description: 'Thông tin tài khoản (Step 5).',
          );
        },
      ),
    ],
  );

  ref.onDispose(router.dispose);
  return router;
});

/// Màn hình tạm cho các tính năng chưa viết. Có nút đăng xuất để kiểm tra
/// Auth Guard; sẽ được thay bằng màn hình thật ở các bước sau.
class _PlaceholderScreen extends ConsumerWidget {
  const _PlaceholderScreen({
    required this.title,
    required this.description,
    this.requiresAuth = true,
  });

  final String title;
  final String description;
  final bool requiresAuth;

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final ThemeData theme = Theme.of(context);
    final AuthUser? user =
        requiresAuth ? ref.watch(authSessionControllerProvider).user : null;

    return Scaffold(
      appBar: AppBar(title: Text(title)),
      body: SafeArea(
        child: Center(
          child: Padding(
            padding: const EdgeInsets.all(24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: <Widget>[
                Icon(
                  Icons.construction_rounded,
                  size: 56,
                  color: theme.colorScheme.primary,
                ),
                const SizedBox(height: 16),
                if (user != null) ...<Widget>[
                  Text(
                    'Xin chào, ${user.displayName}',
                    textAlign: TextAlign.center,
                    style: theme.textTheme.titleMedium?.copyWith(
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    'Vai trò: ${user.role.label}',
                    textAlign: TextAlign.center,
                    style: theme.textTheme.bodyMedium,
                  ),
                  const SizedBox(height: 12),
                ],
                Text(
                  description,
                  textAlign: TextAlign.center,
                  style: theme.textTheme.bodyMedium,
                ),
                const SizedBox(height: 24),
                if (requiresAuth)
                  FilledButton.icon(
                    onPressed: () => ref.read(authRepositoryProvider).logout(),
                    icon: const Icon(Icons.logout),
                    label: const Text('Đăng xuất'),
                  )
                else
                  FilledButton.icon(
                    onPressed: () => context.go(AppRoutes.login),
                    icon: const Icon(Icons.arrow_back),
                    label: const Text('Quay lại đăng nhập'),
                  ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class _NotFoundScreen extends ConsumerWidget {
  const _NotFoundScreen();

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final ThemeData theme = Theme.of(context);
    final AuthUser? user = ref.watch(authSessionControllerProvider).user;
    final String home =
        user == null ? AppRoutes.login : homeRouteFor(user.role);

    return Scaffold(
      body: SafeArea(
        child: Center(
          child: Padding(
            padding: const EdgeInsets.all(24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: <Widget>[
                Icon(
                  Icons.search_off_rounded,
                  size: 64,
                  color: theme.colorScheme.error,
                ),
                const SizedBox(height: 16),
                Text(
                  'Không tìm thấy trang',
                  style: theme.textTheme.titleLarge?.copyWith(
                    fontWeight: FontWeight.w700,
                  ),
                ),
                const SizedBox(height: 24),
                FilledButton(
                  onPressed: () => context.go(home),
                  child: const Text('Về trang chính'),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
