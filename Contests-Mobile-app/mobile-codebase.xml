<file path="lib/core/router/auth_guard.dart">
import 'dart:async';

import 'package:flutter/foundation.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../features/auth/data/auth_repository.dart';
import '../../features/auth/domain/auth_user.dart';
import '../network/api_client.dart';
import 'app_routes.dart';

/// Trạng thái phiên đăng nhập mà router cần biết.
enum SessionStatus {
  /// Đang khôi phục phiên từ token đã lưu (màn hình splash).
  restoring,

  /// Đã đăng nhập.
  authenticated,

  /// Chưa đăng nhập hoặc phiên đã hết hạn.
  unauthenticated,

  /// Không khôi phục được vì lỗi mạng/máy chủ; cho phép người dùng thử lại.
  failed,
}

/// Theo dõi trạng thái phiên và là `refreshListenable` của `GoRouter`.
class AuthSessionController extends ChangeNotifier {
  AuthSessionController(this._repository) {
    _repository.userListenable.addListener(_handleUserChanged);
  }

  final AuthRepository _repository;

  SessionStatus _status = SessionStatus.restoring;
  ApiException? _restoreError;
  bool _isRestoring = false;
  bool _isDisposed = false;

  SessionStatus get status => _status;

  AuthUser? get user => _repository.currentUser;

  /// Lỗi của lần khôi phục phiên gần nhất (khi `status == failed`).
  ApiException? get restoreError => _restoreError;

  /// Khôi phục phiên khi mở app, hoặc thử lại sau lỗi mạng.
  Future<void> restore() async {
    if (_isRestoring) {
      return;
    }

    _isRestoring = true;
    _restoreError = null;
    _setStatus(SessionStatus.restoring);

    try {
      final AuthUser? restored = await _repository.restoreSession();
      _setStatus(
        restored == null
            ? SessionStatus.unauthenticated
            : SessionStatus.authenticated,
      );
    } on ApiException catch (error) {
      _restoreError = error;
      _setStatus(SessionStatus.failed);
    } catch (_) {
      _restoreError = const ApiException(
        message: 'Không thể khôi phục phiên đăng nhập. Vui lòng thử lại.',
      );
      _setStatus(SessionStatus.failed);
    } finally {
      _isRestoring = false;
    }
  }

  /// Bỏ phiên cũ và chuyển sang màn hình đăng nhập (dùng khi khôi phục lỗi).
  Future<void> discardSession() async {
    await _repository.logout();
    _restoreError = null;
    _setStatus(SessionStatus.unauthenticated);
  }

  void _handleUserChanged() {
    // Trong lúc khôi phục, `restore()` sẽ tự đặt trạng thái cuối cùng.
    if (_isRestoring) {
      return;
    }
    _setStatus(
      _repository.currentUser == null
          ? SessionStatus.unauthenticated
          : SessionStatus.authenticated,
    );
  }

  void _setStatus(SessionStatus next) {
    if (_status == next) {
      return;
    }
    _status = next;
    if (!_isDisposed) {
      notifyListeners();
    }
  }

  @override
  void dispose() {
    _isDisposed = true;
    _repository.userListenable.removeListener(_handleUserChanged);
    super.dispose();
  }
}

/// Màn hình chính tương ứng với từng vai trò.
String homeRouteFor(UserRole role) {
  switch (role) {
    case UserRole.student:
      return AppRoutes.studentDashboard;
    case UserRole.judge:
      return AppRoutes.judgeContests;
    case UserRole.admin:
      return AppRoutes.login;
  }
}

/// Quy tắc điều hướng của Auth Guard. Hàm thuần, không phụ thuộc Flutter nên
/// dễ viết unit test. Trả về `null` nghĩa là cho phép vào đường dẫn hiện tại.
///
/// - Đang khôi phục/lỗi khôi phục: luôn ở màn hình splash.
/// - Chưa đăng nhập: chỉ vào được đăng nhập, đăng ký, quên mật khẩu.
/// - Đã đăng nhập: không vào lại các trang trên; chỉ vào khu vực đúng vai trò.
String? resolveAuthRedirect({
  required SessionStatus status,
  required AuthUser? user,
  required String location,
}) {
  final String path = Uri.parse(location).path;

  switch (status) {
    case SessionStatus.restoring:
    case SessionStatus.failed:
      return path == AppRoutes.splash ? null : AppRoutes.splash;

    case SessionStatus.unauthenticated:
      return _redirectForGuest(path);

    case SessionStatus.authenticated:
      if (user == null) {
        return _redirectForGuest(path);
      }

      // Ứng dụng chỉ hỗ trợ Thí sinh và Trọng tài.
      if (user.role != UserRole.student && user.role != UserRole.judge) {
        return _redirectForGuest(path);
      }

      final String home = homeRouteFor(user.role);

      if (path == AppRoutes.splash || AppRoutes.isAuthPage(path)) {
        return home;
      }
      if (AppRoutes.isStudentArea(path) && user.role != UserRole.student) {
        return home;
      }
      if (AppRoutes.isJudgeArea(path) && user.role != UserRole.judge) {
        return home;
      }
      return null;
  }
}

String? _redirectForGuest(String path) {
  if (AppRoutes.isAuthPage(path)) {
    return null;
  }
  return AppRoutes.login;
}

/// Provider `AuthSessionController`. Tự bắt đầu khôi phục phiên ngay khi được
/// tạo lần đầu.
final Provider<AuthSessionController> authSessionControllerProvider =
    Provider<AuthSessionController>((ref) {
  final AuthSessionController controller = AuthSessionController(
    ref.watch(authRepositoryProvider),
  );
  ref.onDispose(controller.dispose);
  unawaited(controller.restore());
  return controller;
});
</file>

<file path="lib/core/storage/token_storage.dart">
import 'package:flutter/foundation.dart';
import 'package:flutter/services.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_secure_storage/flutter_secure_storage.dart';

import '../config/env.dart';

/// Lỗi phát sinh khi đọc / ghi kho lưu trữ token an toàn.
class TokenStorageException implements Exception {
  const TokenStorageException(this.message, {this.cause});

  final String message;
  final Object? cause;

  @override
  String toString() => 'TokenStorageException: $message'
      '${cause != null ? ' (nguyên nhân: $cause)' : ''}';
}

/// Lưu trữ AccessToken và RefreshToken bằng `flutter_secure_storage`
/// (Keychain trên iOS, EncryptedSharedPreferences/Keystore trên Android).
///
/// Backend xác thực bằng cookie httpOnly, nên ngoài việc lưu token lớp này còn
/// dựng sẵn giá trị header `Cookie` để `ApiClient` và Socket.IO sử dụng.
class TokenStorage {
  TokenStorage({FlutterSecureStorage? secureStorage})
      : _storage = secureStorage ??
            const FlutterSecureStorage(
              aOptions: AndroidOptions(encryptedSharedPreferences: true),
              iOptions: IOSOptions(
                accessibility: KeychainAccessibility.first_unlock,
              ),
            );

  static const String _accessTokenKey = 'auth.access_token';
  static const String _refreshTokenKey = 'auth.refresh_token';

  final FlutterSecureStorage _storage;

  // Bộ nhớ đệm để tránh truy cập Keystore/Keychain ở mỗi request.
  String? _accessTokenCache;
  String? _refreshTokenCache;
  bool _isLoaded = false;
  Future<void>? _loading;

  // ---------------------------------------------------------------------------
  // Đọc
  // ---------------------------------------------------------------------------

  /// Nạp token từ kho an toàn vào bộ nhớ đệm (chỉ thực hiện thật sự một lần).
  Future<void> init() => _ensureLoaded();

  Future<String?> readAccessToken() async {
    await _ensureLoaded();
    return _accessTokenCache;
  }

  Future<String?> readRefreshToken() async {
    await _ensureLoaded();
    return _refreshTokenCache;
  }

  /// Có token hợp lệ về mặt hình thức để thử khôi phục phiên đăng nhập.
  /// Chỉ cần còn refreshToken là có thể xin accessToken mới.
  Future<bool> hasSession() async {
    await _ensureLoaded();
    return _isNotBlank(_refreshTokenCache) || _isNotBlank(_accessTokenCache);
  }

  /// Dựng giá trị header `Cookie` theo đúng tên cookie Backend đang đọc
  /// (`accessToken`, `refreshToken`). Trả về `null` nếu chưa có token nào.
  ///
  /// Socket.IO chỉ cần accessToken nên có thể truyền `includeRefresh: false`.
  Future<String?> buildCookieHeader({
    bool includeAccess = true,
    bool includeRefresh = true,
  }) async {
    await _ensureLoaded();

    final List<String> parts = <String>[];

    if (includeAccess && _isNotBlank(_accessTokenCache)) {
      parts.add('${Env.accessTokenCookieName}=$_accessTokenCache');
    }
    if (includeRefresh && _isNotBlank(_refreshTokenCache)) {
      parts.add('${Env.refreshTokenCookieName}=$_refreshTokenCache');
    }

    if (parts.isEmpty) {
      return null;
    }
    return parts.join('; ');
  }

  // ---------------------------------------------------------------------------
  // Ghi
  // ---------------------------------------------------------------------------

  /// Lưu token. Tham số nào là `null` thì giữ nguyên giá trị hiện có.
  Future<void> saveTokens({String? accessToken, String? refreshToken}) async {
    await _ensureLoaded();

    try {
      if (accessToken != null) {
        await _storage.write(key: _accessTokenKey, value: accessToken);
        _accessTokenCache = accessToken;
      }
      if (refreshToken != null) {
        await _storage.write(key: _refreshTokenKey, value: refreshToken);
        _refreshTokenCache = refreshToken;
      }
    } on PlatformException catch (error) {
      throw TokenStorageException('Không thể lưu token an toàn.',
          cause: error);
    } catch (error) {
      throw TokenStorageException('Lỗi không xác định khi lưu token.',
          cause: error);
    }
  }

  Future<void> clearAccessToken() async {
    await _ensureLoaded();

    try {
      await _storage.delete(key: _accessTokenKey);
      _accessTokenCache = null;
    } on PlatformException catch (error) {
      throw TokenStorageException('Không thể xóa accessToken.', cause: error);
    } catch (error) {
      throw TokenStorageException('Lỗi không xác định khi xóa accessToken.',
          cause: error);
    }
  }

  Future<void> clearRefreshToken() async {
    await _ensureLoaded();

    try {
      await _storage.delete(key: _refreshTokenKey);
      _refreshTokenCache = null;
    } on PlatformException catch (error) {
      throw TokenStorageException('Không thể xóa refreshToken.', cause: error);
    } catch (error) {
      throw TokenStorageException('Lỗi không xác định khi xóa refreshToken.',
          cause: error);
    }
  }

  /// Xóa toàn bộ token (đăng xuất hoặc phiên hết hạn).
  Future<void> clear() async {
    // Dù lưu trữ lỗi, bộ nhớ đệm vẫn phải được dọn để request sau không
    // tiếp tục gửi token cũ.
    _accessTokenCache = null;
    _refreshTokenCache = null;
    _isLoaded = true;

    try {
      await _storage.delete(key: _accessTokenKey);
      await _storage.delete(key: _refreshTokenKey);
    } on PlatformException catch (error) {
      throw TokenStorageException('Không thể xóa token.', cause: error);
    } catch (error) {
      throw TokenStorageException('Lỗi không xác định khi xóa token.',
          cause: error);
    }
  }

  // ---------------------------------------------------------------------------
  // Nội bộ
  // ---------------------------------------------------------------------------

  Future<void> _ensureLoaded() {
    if (_isLoaded) {
      return Future<void>.value();
    }
    return _loading ??= _loadFromStorage().whenComplete(() => _loading = null);
  }

  Future<void> _loadFromStorage() async {
    try {
      _accessTokenCache = await _storage.read(key: _accessTokenKey);
      _refreshTokenCache = await _storage.read(key: _refreshTokenKey);
    } on PlatformException catch (error) {
      // Keystore/Keychain có thể bị hỏng (ví dụ sau khi khôi phục máy).
      // Dữ liệu không đọc được nữa nên xóa sạch để người dùng đăng nhập lại.
      debugPrint('[TokenStorage] Không đọc được kho an toàn: $error');
      _accessTokenCache = null;
      _refreshTokenCache = null;
      try {
        await _storage.deleteAll();
      } catch (deleteError) {
        debugPrint('[TokenStorage] Không thể dọn kho an toàn: $deleteError');
      }
    } catch (error) {
      debugPrint('[TokenStorage] Lỗi không xác định khi đọc token: $error');
      _accessTokenCache = null;
      _refreshTokenCache = null;
    } finally {
      _isLoaded = true;
    }
  }

  static bool _isNotBlank(String? value) =>
      value != null && value.trim().isNotEmpty;
}

/// Provider dùng chung cho toàn app.
final Provider<TokenStorage> tokenStorageProvider =
    Provider<TokenStorage>((ref) => TokenStorage());
</file>

<file path="lib/features/auth/data/auth_api.dart">
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../../core/network/api_client.dart';
import '../domain/auth_user.dart';

/// Kết quả của `POST /auth/login` và `POST /auth/student-login`.
///
/// Backend chỉ trả `{ role, accessToken }` trong body. Token chính thức
/// (accessToken + refreshToken) nằm ở header `Set-Cookie` và đã được
/// `ApiClient` tự lưu vào `TokenStorage`.
class LoginResponse {
  const LoginResponse({required this.role, this.accessToken});

  final UserRole role;

  /// Bản sao accessToken trong body, chỉ dùng làm phương án dự phòng.
  final String? accessToken;

  factory LoginResponse.fromJson(Map<String, dynamic> json) {
    final UserRole? role = UserRole.tryParse(json['role']);
    if (role == null) {
      throw const FormatException('Phản hồi đăng nhập thiếu vai trò.');
    }

    final Object? token = json['accessToken'];
    return LoginResponse(
      role: role,
      accessToken: token is String && token.isNotEmpty ? token : null,
    );
  }
}

/// Gọi các endpoint xác thực của Backend (`/api/auth/...`).
///
/// Mọi phương thức ném `ApiException` với thông điệp tiếng Việt khi thất bại.
class AuthApi {
  AuthApi(this._client);

  final ApiClient _client;

  static const String _loginPath = '/auth/login';
  static const String _studentLoginPath = '/auth/student-login';
  static const String _profilePath = '/auth/profile';
  static const String _studentProfilePath = '/auth/profile-student';
  static const String _logoutPath = '/auth/logout';

  /// Đăng nhập Trọng tài (Backend từ chối tài khoản Student ở endpoint này).
  Future<LoginResponse> login({
    required String identifier,
    required String password,
  }) {
    return _loginRequest(
      path: _loginPath,
      identifier: identifier,
      password: password,
    );
  }

  /// Đăng nhập Thí sinh (Backend từ chối tài khoản không phải Student).
  Future<LoginResponse> studentLogin({
    required String identifier,
    required String password,
  }) {
    return _loginRequest(
      path: _studentLoginPath,
      identifier: identifier,
      password: password,
    );
  }

  /// `GET /auth/profile` cho mọi vai trò.
  Future<AuthUser> getProfile() {
    return _guard<AuthUser>(
      failureMessage: 'Không thể tải thông tin tài khoản.',
      action: () async {
        final ApiResult result = await _client.get(_profilePath);
        return AuthUser.fromProfileJson(result.dataAsMap);
      },
    );
  }

  /// `GET /auth/profile-student` chỉ dành cho Student: thông tin thí sinh,
  /// cuộc thi và danh sách trận đấu.
  Future<StudentProfile> getStudentProfile() {
    return _guard<StudentProfile>(
      failureMessage: 'Không thể tải thông tin thí sinh.',
      action: () async {
        final ApiResult result = await _client.get(_studentProfilePath);
        return StudentProfile.fromJson(result.dataAsMap);
      },
    );
  }

  /// `POST /auth/logout`: Backend xóa token trong DB và xóa cookie.
  Future<void> logout() {
    return _guard<void>(
      failureMessage: 'Không thể đăng xuất khỏi máy chủ.',
      action: () async {
        await _client.post(_logoutPath);
      },
    );
  }

  // ---------------------------------------------------------------------------
  // Nội bộ
  // ---------------------------------------------------------------------------

  Future<LoginResponse> _loginRequest({
    required String path,
    required String identifier,
    required String password,
  }) {
    return _guard<LoginResponse>(
      failureMessage: 'Đăng nhập thất bại. Vui lòng thử lại.',
      action: () async {
        final ApiResult result = await _client.post(
          path,
          data: <String, dynamic>{
            'identifier': identifier,
            'password': password,
          },
          // Đăng nhập là endpoint công khai: không gắn cookie cũ và không
          // kích hoạt auto refresh khi sai mật khẩu.
          requiresAuth: false,
        );
        return LoginResponse.fromJson(result.dataAsMap);
      },
    );
  }

  Future<T> _guard<T>({
    required Future<T> Function() action,
    required String failureMessage,
  }) async {
    try {
      return await action();
    } on ApiException {
      rethrow;
    } on FormatException catch (error) {
      throw ApiException(
        message: 'Dữ liệu máy chủ trả về không hợp lệ: ${error.message}',
        code: 'INVALID_RESPONSE',
      );
    } catch (_) {
      throw ApiException(message: failureMessage);
    }
  }
}

/// Provider `AuthApi`.
final Provider<AuthApi> authApiProvider = Provider<AuthApi>(
  (ref) => AuthApi(ref.watch(apiClientProvider)),
);
